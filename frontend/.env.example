# Optional: call the API directly (skips the /api dev proxy in next.config.ts)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# If unset, the browser uses same-origin /api/* (rewritten to 127.0.0.1:8000).

# Watch and Download do not read the chain or a public IPFS gateway in the
# browser. The authenticated API verifies each segment before returning bytes.
# Chain and IPFS settings live in backend/.env.example.
