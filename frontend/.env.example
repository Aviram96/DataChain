# Optional: call the API directly (skips the /api dev proxy in next.config.ts)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# If unset, the browser uses same-origin /api/* (rewritten to 127.0.0.1:8000).

# Public IPFS HTTP gateway for Watch playback (Slice E / CP-E.C5).
# URL pattern: {NEXT_PUBLIC_IPFS_GATEWAY}/ipfs/{cid}
# Origin only — do not include a trailing slash or /ipfs.
# Default if unset: https://gateway.pinata.cloud (Pinata-pinned minutes).
# Restart `npm run dev` after changing NEXT_PUBLIC_* values.
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# Browser verification (Slice E / CP-E.C7): ethers.js getSegment vs API CID/hash.
# The dev server proxies /amoy-rpc → this URL (avoids browser CORS on the RPC).
# NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-amoy.drpc.org
# NEXT_PUBLIC_POLYGON_CHAIN_ID=80002
# Live Amoy Datachain (override if you redeploy):
# NEXT_PUBLIC_DATACHAIN_CONTRACT_ADDRESS=0xc957f61ba4f71a114a1a3983f907e450e3e4c9b3
# NEXT_PUBLIC_POLYGONSCAN_TX_BASE=https://amoy.polygonscan.com/tx
