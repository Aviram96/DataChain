# PostgreSQL connection URL used by SQLAlchemy and Alembic
DATABASE_URL=postgresql+psycopg://datachain:datachain_dev@localhost:5432/datachain

# Optional: bcrypt cost factor for password hashing (4–31; default 12)
# BCRYPT_ROUNDS=12

# Required for JWT access tokens (use a long random string; never commit real secrets)
JWT_SECRET_KEY=
# Optional: access token lifetime in minutes (default 60; max 10080 = 7 days)
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API (Epic 3 frontend)
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional: TCP reachability probe timeout in seconds for camera online/offline (US-4.6)
# CAMERA_PROBE_TIMEOUT_SECONDS=2

# Slice C / CP-C.P1: local .mp4 used by scripts/simulate_cctv_feed.py (or pass --source)
# CCTV_SOURCE_MP4=C:\path\to\sample.mp4

# Epic 5 / Slice C: chunk output directory (default backend/temp).
# Camera ingest stages files under <temp>/<camera-id>/ until processing succeeds.
# Temp files are deleted only after processing succeeds; failures stay for retry.
# CCTV_TEMP_DIR=C:\path\to\custom\temp

# Epic 5: segment length in seconds (default 60)
# CCTV_CHUNK_DURATION_SECONDS=60

# Epic 5: delay before restarting FFmpeg after a crash (default 2)
# CCTV_FFMPEG_RESTART_DELAY_SECONDS=2

# Camera ingest FFmpeg restart cap (default 10). After the cap, the camera is
# marked offline (ingest_offline_at). Unset still means unlimited for the
# Epic 5 feed simulator / loop chunker.
# CCTV_FFMPEG_MAX_RESTARTS=10

# Slice D / CP-D.P1: Pinata JWT for IPFS upload (never commit the real token).
# PINATA_JWT=
# Optional upload timeout in seconds (default 120; clamped 5–600)
# PINATA_TIMEOUT_SECONDS=120

# Slice D / CP-D.P4: Datachain contract on Polygon Amoy (after you run npm run deploy:amoy).
# DATACHAIN_CONTRACT_ADDRESS=
